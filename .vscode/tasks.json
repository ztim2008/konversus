{
  "$schema": "https://schema.store/schemas/json/vscode/tasks.json",
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build TypeScript",
      "type": "shell",
      "command": "node",
      "args": ["./node_modules/typescript/bin/tsc"],
      "problemMatcher": ["$tsc"],
      "group": "build"
    },
    {
      "label": "Remove Inthemer Legacy",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/remove-inthemer.ps1",
        "-Force"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Start (Node)",
      "type": "shell",
      "command": "node",
      "args": ["dist/index.js"],
      "dependsOn": "Build TypeScript",
      "problemMatcher": []
    },
    {
      "label": "GC Service: Dev (ts-node-dev)",
      "type": "shell",
      "command": "node",
      "args": [
        "./node_modules/ts-node-dev/lib/bin.js",
        "--respawn",
        "--transpile-only",
        "src/index.ts"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "$env:PORT=3400; $env:HOST='127.0.0.1'; node ./node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/index.ts"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}/gc-service"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "GC Service: Build",
      "type": "shell",
      "command": "node",
      "args": ["./node_modules/typescript/bin/tsc"],
      "options": {
        "cwd": "${workspaceFolder}/gc-service"
      },
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "GC Service: Start (prod)",
      "type": "shell",
      "command": "node",
      "args": ["dist/index.js"],
      "options": {
        "cwd": "${workspaceFolder}/gc-service"
      },
      "dependsOn": "GC Service: Build",
      "problemMatcher": []
    },
    {
      "label": "GC Service: Health",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "try { $r=Invoke-WebRequest -UseBasicParsing http://localhost:3400/embed/health -TimeoutSec 3; Write-Host ('Status=' + $r.StatusCode); Write-Output $r.Content } catch { Write-Host $_.Exception.Message; exit 1 }"
      ],
      "problemMatcher": []
    },
    {
      "label": "MAX Service: Dev (ts-node-dev)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location '${workspaceFolder}/maxm-service'; if(!(Test-Path node_modules)){ & npm.cmd install }; $env:PORT=3600; $env:HOST='127.0.0.1'; $env:MAXM_SKIP_ENTITLEMENT='1'; npx.cmd ts-node-dev --respawn --transpile-only src/index.ts"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Cookie Notice: Dev (ts-node-dev)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location '${workspaceFolder}/services/cookie-notice'; if(!(Test-Path node_modules)){ & npm.cmd install }; $env:PORT=3701; $env:HOST='127.0.0.1'; npx.cmd ts-node-dev --respawn --transpile-only src/index.ts"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Build and Deploy All Services",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/build-and-deploy.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Avito Portfolio V2: Dev Server",
      "type": "shell",
      "command": "npx",
      "args": ["next", "dev", "-p", "3100"],
      "options": {
        "cwd": "${workspaceFolder}/avito-portfolio-v2",
        "env": {
          "NODE_ENV": "development"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting...",
          "endsPattern": "(Ready in|Compiled)"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
